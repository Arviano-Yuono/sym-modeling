{
  "extends": "_base.json",
  "sgeppy": {
    "data_dir": "dataset/fem_data/plate_hole_fenics/NH2",
    "loadsteps": [10, 20, 30, 40],
    "output_dir": "output/sgeppy_results_torch/nh2",
    "cache_size": 1024,
    "cache_device_outputs": false,
    "weak_form": {
      "balance": 100.0,
      "penalty_lp": 1,
      "p": 0.25,
      "num_increments": 5,
      "factor_increments": 5.0,
      "num_guesses": 200,
      "num_iterations": 200,
      "threshold_iter": 1e-6,
      "threshold": 5e-2
    },
    "model": {
      "variable_names": ["K1", "K2", "Jm1"],
      "binary_operators": ["add", "sub", "mul", "protected_div"],
      "unary_operators": ["square", "cube", "protected_sqrt"],
      "head_length": 3,
      "n_genes": 5,
      "population_size": 150,
      "n_generations": 500,
      "early_stop_value": 1e-14,
      "n_elites": 2,
      "hall_of_fame_size": 5,
      "tournament_size": 2,
      "mut_uniform_ind_pb": 0.03,
      "mut_uniform_pb": 1.0,
      "mut_invert_pb": 0.1,
      "mut_is_transpose_pb": 0.1,
      "mut_ris_transpose_pb": 0.1,
      "mut_gene_transpose_pb": 0.1,
      "cx_one_point_pb": 0.4,
      "cx_two_point_pb": 0.2,
      "cx_gene_pb": 0.1, 
      "fitness_metrics": ["rmse"],
      "fit_intercept": true,
      "regression_method": "stlsq",
      "regression_alpha": 1e-10,
      "regression_threshold": 1e-5,
      "regression_refit": true,
      "random_seed": 0,
      "verbose": true
    }
  }
}
