{
  "sgeppy": {
    "max_elements_per_loadstep": null,
    "noise_level": 0.0,
    "progress_log": true,
    "generation_log": true,
    "backend": "torch",
    "precision": "float64",
    "cache_enabled": true,
    "cache_size": 1024,
    "cache_device_outputs": false,
    "admissibility": {
      "enabled": true,
      "check_training_energy": true,
      "check_path_monotonicity": true,
      "check_reference_stress": true,
      "num_path_samples": 100,
      "min_path_stretch": 1.000001,
      "max_path_stretch": 1000000000.0,
      "energy_tolerance": 1e-7,
      "monotonicity_tolerance": 1e-7,
      "reference_stress_tolerance": 1e-7,
      "reference_stress_step": 1e-8
    },
    "weak_form": {
      "balance": 100.0,
      "penalty_lp": 1e-3,
      "p": 0.2,
      "num_increments": 5,
      "factor_increments": 5.0,
      "num_guesses": 200,
      "num_iterations": 200,
      "threshold_iter": 1e-3,
      "threshold": 0.05
    },
    "model": {
      "variable_names": ["K1", "K2", "Jm1"],
      "binary_operators": ["add", "sub", "mul", "protected_div"],
      "unary_operators": ["square", "cube"],
      "head_length": 2,
      "n_genes": 5,
      "population_size": 200,
      "n_generations": 50,
      "early_stop_value": 1e-14,
      "n_elites": 2,
      "hall_of_fame_size": 3,
      "tournament_size": 2,
      "mut_uniform_ind_pb": 0.03,
      "mut_uniform_pb": 1.0,
      "mut_invert_pb": 0.1,
      "mut_is_transpose_pb": 0.1,
      "mut_ris_transpose_pb": 0.1,
      "mut_gene_transpose_pb": 0.1,
      "cx_one_point_pb": 0.4,
      "cx_two_point_pb": 0.2,
      "cx_gene_pb": 0.1, 
      "fitness_metrics": ["rmse"],
      "fit_intercept": true,
      "regression_method": "stlsq",
      "regression_alpha": 1e-10,
      "regression_threshold": 1e-5,
      "regression_refit": true,
      "random_seed": 0,
      "verbose": true
    }
  }
}
