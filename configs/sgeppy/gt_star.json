{
  "extends": "_base.json",
  "sgeppy": {
    "data_dir": "dataset/fem_data/plate_hole_fenics/GT",
    "loadsteps": [10, 20, 30, 40, 50, 60, 70, 80],
    "output_dir": "output/sgeppy_results_jax/gt",
    "model": {
      "variable_names": ["K1", "K2", "Jm1", "logI13", "logI23"],
      "binary_operators": ["add", "sub", "mul", "protected_div"],
      "unary_operators": ["square", "cube", "protected_sqrt", "protected_log", "protected_exp"],
      "head_length": 4,
      "n_genes": 10
    }
  }
}
